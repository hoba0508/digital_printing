<odoo>
    <!-- List View -->
    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">bajukertas.helpdesk.ticket.list</field>
        <field name="model">bajukertas.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tickets">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">bajukertas.helpdesk.ticket.form</field>
        <field name="model">bajukertas.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button name="action_set_in_progress" string="Start Progress" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_resolve" string="Resolve" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="order_id"/>
                        <field name="description"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Design Files"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">bajukertas.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bajukertas_root" name="BajuKertas"/>
    <menuitem id="menu_bajukertas_helpdesk_root" name="Helpdesk" parent="menu_bajukertas_root"/>
    <menuitem id="menu_bajukertas_helpdesk_tickets" name="Tickets" parent="menu_bajukertas_helpdesk_root" action="action_helpdesk_ticket"/>
</odoo>