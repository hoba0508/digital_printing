<odoo>
    <template id="portal_ticket_form" name="Create Helpdesk Ticket" website="true">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2>Create Helpdesk Ticket for Order: <t t-esc="order.name"/></h2>
                <form t-att-action="'/helpdesk/ticket/submit/%s' % order.id" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" name="name" class="form-control" required/>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Upload Design Files</label>
                        <input type="file" name="attachments" class="form-control" multiple accept="image/*"/>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Submit</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
